# Uncomment the next line to define a global platform for your project
platform :ios, '11.0'

target 'LTios' do
  # Comment the next line if you're not using Swift and don't want to use dynamic frameworks
  use_frameworks!

  # Firebase SDKs
  pod 'Firebase/Core'
  pod 'Firebase/Core'
  pod 'Firebase/Auth'
  pod 'Firebase/Firestore'
  pod 'Firebase/Storage'
  pod 'Firebase/Database'
  
  # Services
  pod 'SwiftLocation'
  pod 'ReachabilitySwift'
  
  # Phone Numbers
  pod 'CryptoSwift'
  pod 'PhoneNumberKit'
  
  # Google SDKs
  pod 'GoogleMaps'
  pod 'GooglePlaces'
  
  # Snapchat/Bitmoji SDK
  pod 'PINCache'
  pod 'SnapSDK'
  
  # Views
  pod 'Spring'
  pod 'ViewAnimator'
  pod 'SCLAlertView'
  #pod 'TextFieldEffects'
  
  # Constraints
  pod 'SnapKit'

  target 'LTiosTests' do
    inherit! :search_paths
    # Pods for testing
  end

  target 'LTiosUITests' do
    inherit! :search_paths
    # Pods for testing
  end

end
